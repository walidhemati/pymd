# Identical-initial-state check: read pymd's positions and velocities, print thermo at 0 and 100.
units           lj
atom_style      atomic
read_data       ${data}
mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

fix             1 all nve
thermo_style    custom step temp epair etotal press
thermo_modify   format float %.10g
thermo          100
run             100
